# =============================================================================
# RealTalk 로컬 개발 환경 변수
#
# 사용 방법:
#   cp .env.example .env
#   .env 파일을 열어 값을 채운 뒤 서버를 기동한다.
#   .env는 Git 추적에서 제외되어 있으니 실제 값을 직접 입력해도 안전하다.
# =============================================================================


# -----------------------------------------------------------------------------
# [1] 데이터베이스 — docker-compose.yml 기준 기본값으로 채워져 있음
#     docker-compose up -d 후 그대로 사용 가능
# -----------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=realtalk
MYSQL_USERNAME=root
MYSQL_PASSWORD=realtalk


# -----------------------------------------------------------------------------
# [2] Redis — docker-compose.yml 기준 기본값
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379


# -----------------------------------------------------------------------------
# [3] JWT
#     !! 반드시 32자(256 bit) 이상의 랜덤 문자열로 변경할 것
#     생성 예: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_32_or_longer_string_here


# -----------------------------------------------------------------------------
# [4] 애플리케이션 URL
#     BASE_URL  : 이 서버 자신의 주소. OAuth2 redirect URI에 사용됨.
#     FRONTEND_URL : 프론트엔드 주소. CORS 허용 Origin으로 사용됨.
# -----------------------------------------------------------------------------
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# [5] OAuth2 — Google / Kakao 로그인
#
#     Google: https://console.cloud.google.com
#       → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID 생성
#       → 승인된 리디렉션 URI: http://localhost:8080/login/oauth2/code/google
#
#     Kakao: https://developers.kakao.com
#       → 앱 → 앱 설정 → 플랫폼 → Redirect URI 등록
#       → http://localhost:8080/login/oauth2/code/kakao
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# [6] Claude AI (Anthropic)
#     https://console.anthropic.com → API Keys
#     AI 요약/팩트체크 기능에 사용됨. 없으면 서버 기동 자체가 불가.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# [7] Google Cloud Speech-to-Text (선택)
#     없으면 서버는 정상 기동되며, STT 요청 시점에만 오류 발생.
#
#     발급 방법:
#       1. GCP Console → IAM → 서비스 계정 → 키 생성 (JSON)
#       2. 다운받은 파일 내용을 한 줄로 변환:
#            cat key.json | tr -d '\n'
#       3. 아래에 붙여넣기 (따옴표 없이)
# -----------------------------------------------------------------------------
GCP_CREDENTIALS_JSON=


# -----------------------------------------------------------------------------
# [8] 서버 포트 (선택, 기본값: 8080)
# -----------------------------------------------------------------------------
# SERVER_PORT=8080


# -----------------------------------------------------------------------------
# [9] Sentry 오류 추적 (선택)
#     없으면 무시됨.
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=local
